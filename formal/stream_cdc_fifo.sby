# stream_cdc_fifo: asynchronous FIFO with two free-running clocks.
# prove: unbounded proof (ABC PDR) at WIDTH=4, ADDR=2 (4 entries)
# cover: full, tracked word read and the FIFO drained, tracked word read
[tasks]
prove
cover

[options]
multiclock on
prove: mode prove
cover: mode cover
cover: depth 40

[engines]
prove: abc pdr
cover: smtbmc yices

[script]
plugin -i slang
read_slang -D FORMAL stream_cdc_fifo.sv stream_cdc_fifo_formal.sv --top stream_cdc_fifo_formal
prep -top stream_cdc_fifo_formal

[files]
../rtl/stream_cdc_fifo.sv
stream_cdc_fifo_formal.sv
