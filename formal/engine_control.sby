# engine_control: AXI-Lite slave protocol and ring counter invariants.
# prove: unbounded proof (k-induction, depth 6; the harness's helper
#        invariants make every property inductive)
# cover: reachability of the main events
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 24

[engines]
prove: smtbmc yices
cover: smtbmc yices

[script]
plugin -i slang
read_slang -D FORMAL engine_control.sv engine_control_formal.sv --top engine_control_formal
prep -top engine_control_formal

[files]
../rtl/engine_control.sv
engine_control_formal.sv
